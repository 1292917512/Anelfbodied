{
  "name": "desktop-embodied",
  "productName": "Embodied",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An independent desktop companion with a shared message and MCP control runtime",
  "license": "MIT",
  "author": "DeskTop Embodied contributors",
  "main": "dist/host/main.js",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "pnpm build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check src tests scripts *.json *.ts *.mjs *.yaml README.md docs .github",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "eventsource-parser": "4.1.3",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "^10.0.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "cn.anelf.embodied",
    "productName": "Embodied",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "win": {
      "icon": "src/renderer/public/skins/fox/fox.png",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  }
}
